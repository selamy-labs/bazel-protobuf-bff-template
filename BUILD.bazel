load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@bff_template_quality//:defs.bzl", "quality_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/hooks:tools.bzl", "QUALITY_TOOLS")

exports_files(
    [
        "tools/checks/dependency_rules.sh",
        "tools/checks/dependency_rules_test.sh",
    ],
    visibility = [
        "//api:__pkg__",
        "//bff:__pkg__",
    ],
)

exports_files(
    [
        ".gitleaks.toml",
        "_typos.toml",
        "docs/quality/hooks.md",
        "prek.toml",
    ],
    visibility = ["//tools/hooks:__pkg__"],
)

npm_link_all_packages(name = "node_modules")

prettier_bin.prettier_binary(
    name = "prettier",
    visibility = ["//tools/hooks:__pkg__"],
)

# Runs the app locally with test identity. See tools/dev/dev.sh.
alias(
    name = "dev",
    testonly = True,
    actual = "//tools/dev",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "workspace_policy",
    srcs = ["tools/policy/workspace_policy.sh"],
)

sh_test(
    name = "bzlmod_policy_test",
    size = "small",
    srcs = ["tools/policy/bzlmod_test.sh"],
    args = ["$(rootpath :workspace_policy)"],
    data = [":workspace_policy"],
)

SCAFFOLD = glob(
    [
        ".claude/skills/**",
        ".specify/scripts/**",
        ".specify/templates/**",
        ".specify/workflows/**",
        ".specify/integrations/**",
    ],
) + [
    ".specify/.gitignore",
    ".specify/init-options.json",
    ".specify/integration.json",
    ".specify/memory/.constitution-template.json",
]

genrule(
    name = "scaffold_list",
    outs = ["scaffold_list.txt"],
    cmd = "printf '%s\\n' " + " ".join(SCAFFOLD) + " > $@",
)

sh_test(
    name = "speckit_scaffold_test",
    size = "small",
    srcs = ["tools/speckit/scaffold_test.sh"],
    data = SCAFFOLD + [
        "tools/speckit/scaffold.sha256",
        ":scaffold_list",
    ],
    env = {"SCAFFOLD_LIST": "$(rootpath :scaffold_list)"},
)

TOOLS = QUALITY_TOOLS

# The one runner, bound to this repository's registry, paths and tools (spec 006 FR-004, spec 008 R8).
quality_binary(
    name = "quality",
    bazel = "tools/bootstrap/bazel.sh",
    contract = "quality/coverage_floors.json",
    registry = "@bff_template_quality//:registry.textproto",
    registry_path = "quality/registry.textproto",
    tools = QUALITY_TOOLS,
    visibility = ["//visibility:public"],
)

sh_test(
    name = "native_fixtures_test",
    size = "small",
    srcs = ["tools/checks/native_fixtures_test.sh"],
    args = ["%s=$(rootpath %s)" % (name, label) for name, label in sorted(TOOLS.items())] + [
        "NATIVE=$(rootpath @bff_template_quality//adapters:native.sh)",
    ],
    data = sorted(TOOLS.values()) + [
        ".gitleaks.toml",
        "@bff_template_quality//adapters:native.sh",
    ],
)

sh_test(
    name = "policy_base_test",
