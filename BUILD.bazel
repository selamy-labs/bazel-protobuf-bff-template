load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The one entry point: `bazel run //:verify` (specs/002-hermetic-skeleton FR-004).
sh_binary(
    name = "verify",
    srcs = ["tools/verify.sh"],
)

sh_binary(
    name = "workspace_policy",
    srcs = ["tools/policy/workspace_policy.sh"],
)

sh_test(
    name = "bzlmod_policy_test",
    size = "small",
    srcs = ["tools/policy/bzlmod_test.sh"],
    args = ["$(rootpath :workspace_policy)"],
    data = [":workspace_policy"],
)

SCAFFOLD = glob(
    [
        ".claude/skills/**",
        ".specify/scripts/**",
        ".specify/templates/**",
        ".specify/workflows/**",
        ".specify/integrations/**",
    ],
) + [
    ".specify/.gitignore",
    ".specify/init-options.json",
    ".specify/integration.json",
    ".specify/memory/.constitution-template.json",
]

genrule(
    name = "scaffold_list",
    outs = ["scaffold_list.txt"],
    cmd = "printf '%s\\n' " + " ".join(SCAFFOLD) + " > $@",
)

sh_test(
    name = "speckit_scaffold_test",
    size = "small",
    srcs = ["tools/speckit/scaffold_test.sh"],
    data = SCAFFOLD + [
        "tools/speckit/scaffold.sha256",
        ":scaffold_list",
    ],
    env = {"SCAFFOLD_LIST": "$(rootpath :scaffold_list)"},
)

sh_test(
    name = "native_fixtures_test",
    size = "small",
    srcs = ["tools/checks/native_fixtures_test.sh"],
    args = [
        "$(rootpath @bff_template_quality//tools:gitleaks)",
        "$(rootpath @bff_template_quality//tools:typos)",
        "$(rootpath @bff_template_quality//checks/suppression:suppression-ban)",
    ],
    data = [
        "@bff_template_quality//checks/suppression:suppression-ban",
        "@bff_template_quality//tools:gitleaks",
        "@bff_template_quality//tools:typos",
    ],
)

sh_test(
    name = "ci_parity_test",
    size = "small",
    srcs = ["tools/ci/parity_test.sh"],
    data = [".github/workflows/ci.yml"],
)
