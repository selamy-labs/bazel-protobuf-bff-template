load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "tools/checks/dependency_rules.sh",
        "tools/checks/dependency_rules_test.sh",
        "tools/checks/native.sh",
    ],
    visibility = [
        "//api:__pkg__",
        "//bff:__pkg__",
    ],
)

npm_link_all_packages(name = "node_modules")

# Runs the app locally with test identity. See tools/dev/dev.sh.
alias(
    name = "dev",
    testonly = True,
    actual = "//tools/dev",
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "workspace_policy",
    srcs = ["tools/policy/workspace_policy.sh"],
)

sh_test(
    name = "bzlmod_policy_test",
    size = "small",
    srcs = ["tools/policy/bzlmod_test.sh"],
    args = ["$(rootpath :workspace_policy)"],
    data = [":workspace_policy"],
)

SCAFFOLD = glob(
    [
        ".claude/skills/**",
        ".specify/scripts/**",
        ".specify/templates/**",
        ".specify/workflows/**",
        ".specify/integrations/**",
    ],
) + [
    ".specify/.gitignore",
    ".specify/init-options.json",
    ".specify/integration.json",
    ".specify/memory/.constitution-template.json",
]

genrule(
    name = "scaffold_list",
    outs = ["scaffold_list.txt"],
    cmd = "printf '%s\\n' " + " ".join(SCAFFOLD) + " > $@",
)

sh_test(
    name = "speckit_scaffold_test",
    size = "small",
    srcs = ["tools/speckit/scaffold_test.sh"],
    data = SCAFFOLD + [
        "tools/speckit/scaffold.sha256",
        ":scaffold_list",
    ],
    env = {"SCAFFOLD_LIST": "$(rootpath :scaffold_list)"},
)

TOOLS = {
    "ACTIONLINT": "@bff_template_quality//tools:actionlint",
    "BASELINE": "@bff_template_quality//proto/cmd:baseline",
    "BUF": "@bff_template_quality//tools:buf",
    "BUF_CONFIG_FILE": "@bff_template_quality//proto:buf.yaml",
    "BUILDIFIER": "@bff_template_quality//tools:buildifier",
    "GITLEAKS": "@bff_template_quality//tools:gitleaks",
    "GOFMT": "@go_sdk//:bin/gofmt",
    "SHELLCHECK": "@bff_template_quality//tools:shellcheck",
    "SUPPRESSION": "@bff_template_quality//checks/suppression:suppression-ban",
    "TYPOS": "@bff_template_quality//tools:typos",
    "UV": "@bff_template_quality//tools:uv",
    "VALIDATE_PROTO_FILE": "@protovalidate_proto//file",
    "YQ": "@bff_template_quality//tools:yq",
    "ZIZMOR": "@bff_template_quality//tools:zizmor",
}

# Resolves the pinned tools once; the verifier then runs them from the repository root.
sh_binary(
    name = "tool_paths",
    srcs = ["tools/checks/tool_paths.sh"],
    args = ["%s=$(rootpath %s)" % (name, label) for name, label in sorted(TOOLS.items())],
    data = sorted(TOOLS.values()),
)

sh_test(
    name = "native_fixtures_test",
    size = "small",
    srcs = ["tools/checks/native_fixtures_test.sh"],
    args = ["%s=$(rootpath %s)" % (name, label) for name, label in sorted(TOOLS.items())],
    data = sorted(TOOLS.values()) + [
        ".gitleaks.toml",
        "tools/checks/native.sh",
    ],
)

sh_test(
    name = "tool_paths_test",
    size = "small",
    srcs = ["tools/checks/tool_paths_test.sh"],
    args = ["$(rootpath tools/checks/tool_paths.sh)"],
    data = ["tools/checks/tool_paths.sh"],
)

sh_test(
    name = "bazel_pin_test",
    size = "small",
    srcs = ["tools/bootstrap/bazel_pin_test.sh"],
    data = ["tools/bootstrap/bazel.sh"],
)

sh_test(
    name = "verify_body_test",
    size = "small",
    srcs = ["tools/checks/verify_body_test.sh"],
    data = [
        "tools/checks/required_tests.txt",
        "tools/checks/test_evidence.sh",
        "tools/checks/verify_body.sh",
        "tools/verify.sh",
    ],
)

sh_test(
    name = "verify_deadline_test",
    size = "small",
    srcs = ["tools/verify_deadline_test.sh"],
    data = ["tools/verify.sh"],
)

sh_test(
    name = "normalize_json_test",
    size = "small",
    srcs = ["tools/speckit/normalize_json_test.sh"],
    args = ["$(rootpath @bff_template_quality//tools:yq)"],
    data = [
        ".specify/init-options.json",
        ".specify/integrations/speckit.manifest.json",
        ".specify/workflows/workflow-registry.json",
        "tools/speckit/normalize_json.sh",
        "@bff_template_quality//tools:yq",
    ],
)

sh_test(
    name = "inventory_test",
    size = "small",
    srcs = ["tools/checks/inventory_test.sh"],
    data = ["tools/checks/inventory.sh"],
)

sh_binary(
    name = "config_policy",
    srcs = ["tools/policy/config_policy.sh"],
)

sh_test(
    name = "config_policy_test",
    size = "small",
    srcs = ["tools/policy/config_policy_test.sh"],
    args = ["$(rootpath :config_policy)"],
    data = [
        ".bazelrc",
        "tools/policy/bazelrc.allow",
        "tools/policy/bazelrc_policy.sh",
        ":config_policy",
    ],
)

sh_test(
    name = "ci_parity_test",
    size = "small",
    srcs = ["tools/ci/parity_test.sh"],
    args = [
        "$(rootpath @bff_template_quality//tools:yq)",
        "$(rootpath @bff_template_quality//checks/ciparity:ciparity_bin)",
    ],
    data = glob([".github/workflows/**"]) + [
        "tools/ci/mutations.tsv",
        "tools/ci/policy.json",
        "@bff_template_quality//checks/ciparity:ciparity_bin",
        "@bff_template_quality//tools:yq",
    ],
)
