"""Generic Bazel/Protobuf BFF template: root module."""

module(
    name = "bff_template",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "tar.bzl", version = "0.10.4")

# Shared, separately versioned quality checks (spec 001 R-07). Consumers outside this repository
# pin it with git_override at an immutable tag commit instead.
bazel_dep(name = "bff_template_quality", version = "1.0.0")
local_path_override(
    module_name = "bff_template_quality",
    path = "quality",
)

# Go SDK pinned by version and per-platform sha256 (spec 002 research R1).
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    sdks = {
        "darwin_arm64": ("go1.27.2.darwin-arm64.tar.gz", "76812b213b1b2302c978d28fa52fa92d541704b9e7d9d5db8002c50e4018c4c5"),
        "linux_amd64": ("go1.27.2.linux-amd64.tar.gz", "ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5"),
        "linux_arm64": ("go1.27.2.linux-arm64.tar.gz", "94f3e30b8e374bc285e7dadc11e0865726b9bc6e85b841ccceaabc0214c6b7c8"),
    },
    version = "1.27.2",
)
use_repo(go_sdk, "go_sdk")

# vet and staticcheck run in the Go build, so a finding fails it (spec 006 FR-016).
go_sdk.nogo(
    includes = [
        "//:__subpackages__",
        "@bff_template_quality//:__subpackages__",
    ],
    nogo = "@bff_template_quality//analysis:nogo",
)

# Go dependencies come from go.mod and go.sum (spec 003 research R3).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# cel-go ships BUILD files that use a different naming convention from its importers.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "cel.dev/cel-go",
)
use_repo(
    go_deps,
    "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go",
    "build_buf_go_protovalidate",
    "com_connectrpc_connect_v2",
    "org_golang_google_protobuf",
)

# Node pinned by version and per-platform sha256.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(
    node_repositories = {
        "24.22.0-darwin_arm64": ("node-v24.22.0-darwin-arm64.tar.xz", "node-v24.22.0-darwin-arm64", "75ddfb875bbd868ebe57536f4442225f54dd10f6d2178dd439de869a5c648dc3"),
        "24.22.0-linux_amd64": ("node-v24.22.0-linux-x64.tar.xz", "node-v24.22.0-linux-x64", "cc2f601cee82d9a5a233302fe307abc600727035fd7d2c3a3571755989e95008"),
        "24.22.0-linux_arm64": ("node-v24.22.0-linux-arm64.tar.xz", "node-v24.22.0-linux-arm64", "fef00bb4d36e1c50104a9775a10359beee98f162b4104dd12472c75065c6a143"),
    },
    node_version = "24.22.0",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version_from = "//:package.json")
use_repo(typescript, "npm_typescript")

# The one schema import the contract needs, at release v1.2.2 (spec 003 research R2).
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "protovalidate_proto",
    downloaded_file_path = "validate.proto",
    sha256 = "a1dc1163ebac930b3b070655b91f2bc78df8b4aea940021661fe5ec7904a7b88",
    urls = ["https://raw.githubusercontent.com/bufbuild/protovalidate/4baed765070e580226a0a30bf2a357cc027dc1f7/proto/protovalidate/buf/validate/validate.proto"],
)

# The browser and every library it links, for Linux x86_64 (spec 005 research R1).
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "chrome_headless_shell",
    build_file_content = """exports_files(["chrome-headless-shell"])

filegroup(name = "files", srcs = glob(["**"]), visibility = ["//visibility:public"])
""",
    sha256 = "c3e50596aef52c58f8fda3c6b3411c33d34c88b177b3ed1c2243359fd3b8ba20",
    strip_prefix = "chrome-headless-shell-linux64",
    urls = ["https://cdn.playwright.dev/builds/cft/156.0.8078.4/linux64/chrome-headless-shell-linux64.zip"],
)

# OpenTofu and the GitHub provider, for the offline governance test only (spec 010 FR-009). Both are pinned by
# the sha256 published with their releases, fetched at test time, and never run against a live account.
http_archive(
    name = "opentofu",
    build_file_content = """exports_files(["tofu"], visibility = ["//visibility:public"])""",
    sha256 = "723bebb0df8411daff1e5fc3862e28ff5581fe5634087f4c29a9aa41d78208b5",
    urls = ["https://github.com/opentofu/opentofu/releases/download/v1.13.2/tofu_1.13.2_linux_amd64.zip"],
)

http_file(
    name = "terraform_provider_google",
    sha256 = "ed89123c75b4c65c59cdfa0dd16435eb25dd7f02a87e8971ac543782c0f69986",
    urls = ["https://github.com/opentofu/terraform-provider-google/releases/download/v8.9.0/terraform-provider-google_8.9.0_linux_amd64.zip"],
)

http_file(
    name = "terraform_provider_github",
    downloaded_file_path = "terraform-provider-github_6.13.0_linux_amd64.zip",
    sha256 = "5dd05dee677f6ebdbed00cbb1b9be444ab2d1062d345cbc9ec50a47cb41b8622",
    urls = ["https://github.com/integrations/terraform-provider-github/releases/download/v6.13.0/terraform-provider-github_6.13.0_linux_amd64.zip"],
)

browser_libs = use_repo_rule("//tools/browser:defs.bzl", "browser_libs")

browser_libs(name = "browser_libs")
