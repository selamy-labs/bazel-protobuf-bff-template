load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

ts_project(
    name = "client",
    srcs = [
        "errors.ts",
        "lifecycle.ts",
        "transport.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "//:tsconfig",
    visibility = ["//web:__subpackages__"],
    deps = [
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@connectrpc/connect",
        "//:node_modules/@connectrpc/connect-web",
        "//api:notes_ts",
    ],
)

ts_project(
    name = "client_test",
    testonly = True,
    srcs = [
        "errors.property.test.ts",
        "errors.test.ts",
        "lifecycle.test.ts",
        "transport.test.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "//:tsconfig",
    deps = [
        ":client",
        "//:node_modules/@bufbuild/protobuf",
        "//:node_modules/@connectrpc/connect",
        "//:node_modules/@types/node",
        "//:node_modules/fast-check",
        "//api:notes_ts",
    ],
)

# Runs the tests through Node's own runner, which writes the coverage report under `bazel coverage`.
# rules_js's report keeps only `.ts` entries, and V8 reports the compiled `.js` (spec 007 R7).
js_test(
    name = "client_unit_test",
    size = "small",
    data = [
        "test_main.mjs",
        ":client_test",
    ],
    entry_point = "test_main.mjs",
)

js_library(
    name = "lint_srcs",
    srcs = glob(["*.ts"]),
    visibility = ["//web/lint:__pkg__"],
)
