load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:eslint/package_json.bzl", eslint_bin = "bin")

eslint_bin.eslint_test(
    name = "eslint_test",
    size = "small",
    args = [
        "--config",
        "$(rootpath eslint.config.mjs)",
        "--max-warnings",
        "0",
        "--no-warn-ignored",
        "web",
        "tools/dev/record",
    ],
    data = [
        "eslint.config.mjs",
        "//:node_modules/typescript-eslint",
        "//tools/dev/record:lint_srcs",
        "//web/app:lint_srcs",
        "//web/app/signin:lint_srcs",
        "//web/client:lint_srcs",
        "//web/e2e:lint_srcs",
        "//web/serve:lint_srcs",
        "//web/testing:lint_srcs",
        "@bff_template_quality//:complexity_budgets.json",
    ],
    env = {"COMPLEXITY_BUDGETS": "$(rootpath @bff_template_quality//:complexity_budgets.json)"},
    no_copy_to_bin = ["@bff_template_quality//:complexity_budgets.json"],
)

# The TypeScript complexity budget's planted control (spec 011 FR-005): one over the ceiling refused, at it
# accepted, the ceiling read from the budgets the base comparator judges.
js_test(
    name = "eslint_complexity_witness_test",
    size = "small",
    args = ["--test"],
    data = [
        "eslint.config.mjs",
        "//:node_modules/eslint",
        "//:node_modules/typescript-eslint",
        "@bff_template_quality//:complexity_budgets.json",
    ],
    entry_point = "complexity.test.mjs",
    env = {"COMPLEXITY_BUDGETS": "$(rootpath @bff_template_quality//:complexity_budgets.json)"},
    no_copy_to_bin = ["@bff_template_quality//:complexity_budgets.json"],
)

js_test(
    name = "eslint_witness_test",
    size = "small",
    args = ["--test"],
    data = [
        "//:node_modules/eslint",
        "//:node_modules/typescript-eslint",
        "@bff_template_quality//checks/suppression:spellings",
    ],
    entry_point = "spellings.test.mjs",
    env = {"SPELLINGS": "$(rootpaths @bff_template_quality//checks/suppression:spellings)"},
    no_copy_to_bin = ["@bff_template_quality//checks/suppression:spellings"],
)
