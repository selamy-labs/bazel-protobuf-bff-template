load("@aspect_rules_js//js:defs.bzl", "js_library", "js_test")
load("@npm//:@playwright/test/package_json.bzl", playwright = "bin")
load("@rules_go//go:def.bzl", "go_binary", "go_library")

BROWSER_DATA = ["//tools/browser:browser"]

BROWSER_ENV = {"BROWSER_DIR": "$(rootpath //tools/browser:browser)"}

js_test(
    name = "browser_smoke_test",
    size = "small",
    data = BROWSER_DATA + [
        "issuer.mjs",
        "stack.mjs",
        "//:node_modules/@playwright/test",
        "//web/serve:serve_lib",
    ],
    entry_point = "smoke.mjs",
    env = BROWSER_ENV,
)

E2E_DATA = BROWSER_DATA + [
    "notes.spec.mjs",
    "playwright.config.mjs",
    "issuer.mjs",
    "stack.mjs",
    "//:node_modules/@playwright/test",
    "//web/app:dist_dev",
    "//web/serve:serve_lib",
]

playwright.playwright_test(
    name = "notes_e2e_test",
    size = "medium",
    args = [
        "test",
        "--config",
        "web/e2e/playwright.config.mjs",
    ],
    data = E2E_DATA + ["//bff/cmd/bff-dev"],
    env = BROWSER_ENV | {
        "BFF_BIN": "$(rootpath //bff/cmd/bff-dev)",
        "WEB_DIST": "$(rootpath //web/app:dist_dev)",
    },
)

# The example's inputs, copied into this package: a js_test carries only output-tree files from another package.
genrule(
    name = "example_inputs",
    testonly = True,
    srcs = ["//deploy/gcp/inputs:example.inputs.json"],
    outs = ["example.inputs.json"],
    cmd = "cp $< $@",
)

# The hosted shape, locally (spec 012 FR-019, T014): the page under the example's base path, the backend on
# another origin, the preflight, a foreign origin, announced errors, a reload, the backend's log.
playwright.playwright_test(
    name = "hosted_e2e_test",
    size = "medium",
    args = [
        "test",
        "--config",
        "web/e2e/playwright.config.mjs",
        "hosted.spec.mjs",
    ],
    data = BROWSER_DATA + [
        "hosted.spec.mjs",
        "issuer.mjs",
        "playwright.config.mjs",
        "stack.mjs",
        ":example_inputs",
        "//:node_modules/@playwright/test",
        "//bff/cmd/bff-dev",
        "//web/app:dist_dev",
        "//web/serve:serve_lib",
    ],
    env = BROWSER_ENV | {
        "BFF_BIN": "$(rootpath //bff/cmd/bff-dev)",
        "EXAMPLE_INPUTS": "$(rootpath :example_inputs)",
        "WEB_DIST": "$(rootpath //web/app:dist_dev)",
    },
)

# The journey with the sign-in (spec 012 FR-016, FR-021, T014): the production bundle and the production server
# with its verifier pointed at a local issuer; the sign-in through the issuer's page, the verified calls, a reload,
# sign-out, a declined sign-in, a deep link, an ended session, the development identity refused, the log.
playwright.playwright_test(
    name = "signin_e2e_test",
    size = "medium",
    args = [
        "test",
        "--config",
        "web/e2e/playwright.config.mjs",
        "signin.spec.mjs",
    ],
    data = BROWSER_DATA + [
        "issuer.mjs",
        "playwright.config.mjs",
        "signin.spec.mjs",
        "stack.mjs",
        ":example_inputs",
        "//:node_modules/@playwright/test",
        "//bff/cmd/bff",
        "//web/app:dist",
        "//web/serve:serve_lib",
    ],
    env = BROWSER_ENV | {
        "BFF_PRODUCTION": "$(rootpath //bff/cmd/bff)",
        "EXAMPLE_INPUTS": "$(rootpath :example_inputs)",
        "WEB_DIST_PRODUCTION": "$(rootpath //web/app:dist)",
    },
)

# The whole stack through the one command (spec 012 FR-020 to FR-023): the real launcher, a real browser, a
# restart and a reset. The launcher's own runfiles come along, and DEV_ARGS names them as `bazel run` would.
playwright.playwright_test(
    name = "local_stack_e2e_test",
    size = "large",
    args = [
        "test",
        "--config",
        "web/e2e/playwright.config.mjs",
        "local-stack.spec.mjs",
    ],
    data = BROWSER_DATA + [
        "issuer.mjs",
        "local-stack.spec.mjs",
        "playwright.config.mjs",
        "stack.mjs",
        "//:node_modules/@playwright/test",
        "//bff/cmd/bff-dev",
        "//tools/dev:dev_sh",
        "//tools/dev:profile_json",
        "//tools/dev/profile",
        "//web/app:dist_dev",
        "//web/serve",
    ],
    env = BROWSER_ENV | {
        "DEV_SH": "$(rootpath //tools/dev:dev_sh)",
        "DEV_ARGS": "$(rootpath //bff/cmd/bff-dev) $(rootpath //web/serve) $(rootpath //web/app:dist_dev) $(rootpath //tools/dev/profile) $(rootpath //tools/dev:profile_json)",
    },
)

# The defect witness (spec 005 research R5): the same specs against a server whose error mapping is
# broken in one place. The chain repeats only what must be rebuilt around the edited file.
genrule(
    name = "defect_interceptors",
    testonly = True,
    srcs = ["//bff/transport:interceptors.go"],
    outs = ["defect/interceptors.go"],
    cmd = """sed 's/return connect.NewError(connect.CodeNotFound, "note not found")/return internal(ctx, logger, spec, err)/' $< >$@
if cmp -s $< $@; then echo 'the defect changed nothing' >&2; exit 1; fi""",
)

go_library(
    name = "defect_transport",
    testonly = True,
    srcs = [
        ":defect_interceptors",
        "//bff/transport:cors.go",
        "//bff/transport:handlers.go",
    ],
    importpath = "example.com/bfftemplate/bff/transport",
    deps = [
        "//api:notes_connect_go",
        "//api:notes_go",
        "//bff/app",
        "//bff/identity",
        "//bff/ports",
        "@build_buf_go_protovalidate//:protovalidate",
        "@com_connectrpc_connect_v2//:connect",
        "@com_connectrpc_connect_v2//connecthttp",
        "@com_connectrpc_connect_v2//connectproto",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_library(
    name = "defect_server",
    testonly = True,
    srcs = ["//bff/server:server.go"],
    importpath = "example.com/bfftemplate/bff/server",
    deps = [
        ":defect_transport",
        "//bff/app",
        "//bff/identity",
        "//bff/ports",
    ],
)

go_binary(
    name = "defect_bff",
    testonly = True,
    srcs = ["//bff/cmd/bff-dev:main.go"],
    deps = [
        ":defect_server",
        "//bff/adapters/memory",
        "//bff/adapters/store/local",
        "//bff/ports",
        "//bff/testing/faults",
        "//bff/testing/identity",
    ],
)

js_test(
    name = "defect_e2e_test",
    size = "medium",
    data = E2E_DATA + [":defect_bff"],
    entry_point = "defect.mjs",
    env = BROWSER_ENV | {
        "BFF_BIN": "$(rootpath :defect_bff)",
        "WEB_DIST": "$(rootpath //web/app:dist_dev)",
    },
)

js_library(
    name = "lint_srcs",
    srcs = glob(["*.mjs"]),
    visibility = ["//web/lint:__pkg__"],
)
