load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library")

js_library(
    name = "serve_lib",
    srcs = ["serve.mjs"],
    visibility = ["//web:__subpackages__"],
)

js_binary(
    name = "serve",
    data = [":serve_lib"],
    entry_point = "serve.mjs",
    visibility = [
        "//tools/dev:__pkg__",
        "//web/e2e:__pkg__",
    ],
)

js_library(
    name = "lint_srcs",
    srcs = glob(["*.mjs"]),
    visibility = ["//web/lint:__pkg__"],
)
