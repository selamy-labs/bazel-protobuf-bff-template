load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

# The hosted example's one typed funnel (spec 012 FR-003): every value declared once, validated before any plan.
exports_files(
    [
        "example.inputs.json",
        "testdata/bounds.inputs.json",
        "testdata/budget.inputs.json",
        "testdata/cancel.inputs.json",
        "testdata/rollback.inputs.json",
        "testdata/zero-sample.inputs.json",
    ],
    visibility = [
        "//deploy:__subpackages__",
        "//web/e2e:__pkg__",
    ],
)

go_library(
    name = "inputs",
    srcs = [
        "inputs.go",
        "resolve.go",
        "service_check.go",
        "telemetry.go",
    ],
    importpath = "example.com/bfftemplate/deploy/gcp/inputs",
    visibility = ["//deploy:__subpackages__"],
    deps = [
        "@com_github_hashicorp_hcl_v2//:hcl",
        "@com_github_hashicorp_hcl_v2//hclsyntax",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)

go_test(
    name = "inputs_test",
    size = "small",
    srcs = [
        "inputs_test.go",
        "plan_test.go",
        "resolve_test.go",
        "service_check_test.go",
        "start_test.go",
    ],
    data = [
        "contract.schema.json",
        "example.inputs.json",
        "inputs.schema.json",
        "//bff/cmd/bff",
        "//deploy/gcp:cloudbuild/cloudbuild.yaml",
        "//deploy/gcp:service/main.tf",
    ],
    embed = [":inputs"],
    env = {
        "BFF_BIN": "$(rlocationpath //bff/cmd/bff)",
        "CLOUDBUILD_YAML": "$(rlocationpath //deploy/gcp:cloudbuild/cloudbuild.yaml)",
        "CONTRACT_SCHEMA": "$(rlocationpath contract.schema.json)",
        "EXAMPLE": "$(rlocationpath example.inputs.json)",
        "MAIN_TF": "$(rlocationpath //deploy/gcp:service/main.tf)",
        "SCHEMA": "$(rlocationpath inputs.schema.json)",
    },
)

# The first step of every plan and of the CD pipeline: the inputs validated, the effective values printed.
go_binary(
    name = "validate",
    srcs = ["cmd/validate/main.go"],
    visibility = ["//deploy:__subpackages__"],
    deps = [":inputs"],
)
