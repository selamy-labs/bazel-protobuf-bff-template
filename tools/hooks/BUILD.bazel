load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/hooks:tools.bzl", "QUALITY_TOOLS")

alias(
    name = "install",
    actual = "@bff_template_quality//hooks:install",
)

sh_test(
    name = "fixtures_test",
    size = "large",
    srcs = ["fixtures_test.sh"],
    args = [
        "$(rootpath //:quality)",
        "$(rootpath @bff_template_quality//adapters:native.sh)",
    ] + ["%s=$(rootpath %s)" % (name, label) for name, label in sorted(QUALITY_TOOLS.items())],
    data = sorted(QUALITY_TOOLS.values()) + [
        "fixture_bazel.sh",
        "stage.sh",
        "//:.gitleaks.toml",
        "//:_typos.toml",
        "//:docs/quality/hooks.md",
        "//:prek.toml",
        "//:quality",
        "@bff_template_quality//:registry.textproto",
        "@bff_template_quality//:rules.textproto",
        "@bff_template_quality//adapters:native.sh",
        "@bff_template_quality//hooks:install.sh",
    ],
    env = {
        "CATALOG": "$(rootpath @bff_template_quality//:rules.textproto)",
        "HOOKS_DOC": "$(rootpath //:docs/quality/hooks.md)",
        "INSTALL": "$(rootpath @bff_template_quality//hooks:install.sh)",
        "REGISTRY": "$(rootpath @bff_template_quality//:registry.textproto)",
    },
)
