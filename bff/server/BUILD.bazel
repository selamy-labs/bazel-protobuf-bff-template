load("@rules_go//go:def.bzl", "go_library", "go_test")

exports_files(
    ["server.go"],
    visibility = ["//web/e2e:__pkg__"],
)

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "example.com/bfftemplate/bff/server",
    visibility = ["//bff/cmd:__subpackages__"],
    deps = [
        "//bff/app",
        "//bff/identity",
        "//bff/ports",
        "//bff/transport",
        "@com_connectrpc_connect_v2//:connect",
    ],
)

go_test(
    name = "server_test",
    size = "small",
    srcs = ["server_test.go"],
    embed = [":server"],
    deps = [
        "//bff/adapters/memory",
        "//bff/identity",
        "//bff/testing/identity",
    ],
)
