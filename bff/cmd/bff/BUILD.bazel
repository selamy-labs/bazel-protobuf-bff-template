load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@tar.bzl", "tar")
load(":release.bzl", "release_binary")

go_library(
    name = "bff_lib",
    srcs = [
        "config.go",
        "main.go",
        "verifier.go",
    ],
    importpath = "example.com/bfftemplate/bff/cmd/bff",
    deps = [
        "//bff/adapters/memory",
        "//bff/identity",
        "//bff/server",
    ],
)

go_binary(
    name = "bff",
    embed = [":bff_lib"],
    pure = "on",
    visibility = ["//bff:__subpackages__"],
)

go_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.go"],
    embed = [":bff_lib"],
    deps = [
        "//bff/adapters/memory",
        "//bff/identity",
        "//bff/server",
    ],
)

# The production server as one OCI image (spec 009, contracts/image.md). No base: the binary is pure
# Go and needs no loader. The layer is declared as an mtree, because tar.bzl's mutate helper needs a C++
# toolchain that this repository does not have. Only linux x86_64 is built, and nothing else is labeled.
LINUX_AMD64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

# The packaged binary, from the plain configuration whatever command built the image. See release.bzl.
release_binary(
    name = "bff_release",
    binary = ":bff",
)

tar(
    name = "image_layer",
    srcs = [":bff_release"],
    mtree = ["./bff uid=65532 gid=65532 time=0 mode=0555 type=file content=$(execpath :bff_release)"],
    target_compatible_with = LINUX_AMD64,
)

oci_image(
    name = "image",
    architecture = "amd64",
    entrypoint = ["/bff"],
    os = "linux",
    target_compatible_with = LINUX_AMD64,
    tars = [":image_layer"],
    user = "65532:65532",
    visibility = ["//visibility:public"],
)

# A loadable tarball for a real runtime on a host that has one. The verifier never needs it.
oci_load(
    name = "image_tarball",
    image = ":image",
    repo_tags = ["bff-template/bff:local"],
    target_compatible_with = LINUX_AMD64,
)

# The image witness (spec 009 FR-007). It reads the layout the image target names.
go_test(
    name = "image_test",
    size = "small",
    srcs = ["image_test.go"],
    data = [":image"],
    env = {"IMAGE": "$(rlocationpath :image)"},
    target_compatible_with = LINUX_AMD64,
)
