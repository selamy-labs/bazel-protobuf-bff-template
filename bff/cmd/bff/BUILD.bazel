load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load(":release.bzl", "release_binary")

go_library(
    name = "bff_lib",
    srcs = [
        "config.go",
        "main.go",
        "telemetry.go",
        "verifier.go",
        "web.go",
    ],
    importpath = "example.com/bfftemplate/bff/cmd/bff",
    deps = [
        "//bff/adapters/identity/oidc",
        "//bff/adapters/memory",
        "//bff/adapters/store/object",
        "//bff/identity",
        "//bff/ports",
        "//bff/server",
        "//bff/telemetry",
        "@org_golang_x_crypto_x509roots_fallback//:fallback",
    ],
)

go_binary(
    name = "bff",
    embed = [":bff_lib"],
    pure = "on",
    visibility = [
        "//bff:__subpackages__",
        "//deploy/gcp/inputs:__pkg__",
        "//web/e2e:__pkg__",
    ],
)

go_test(
    name = "config_test",
    size = "small",
    srcs = [
        "config_test.go",
        "telemetry_test.go",
    ],
    embed = [":bff_lib"],
    deps = [
        "//bff/adapters/identity/oidc",
        "//bff/adapters/memory",
        "//bff/adapters/store/object",
        "//bff/identity",
        "//bff/server",
    ],
)

# One production runtime: static Go server and the built production browser, without runfiles.
# Only linux x86_64 is built, and nothing else is labeled (spec 009 T017).
LINUX_AMD64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

# The packaged binary, from the plain configuration whatever command built the image. See release.bzl.
release_binary(
    name = "bff_release",
    binary = ":bff",
)

image_layer(
    name = "image_layer",
    srcs = {
        "/bff": ":bff_release",
        "/web": "//web/app:dist",
    },
    compress = "none",
    default_metadata = file_metadata(
        gid = 65532,
        mode = "0644",
        mtime = "1970-01-01T00:00:00Z",
        uid = 65532,
    ),
    file_metadata = {
        "/bff": file_metadata(mode = "0555"),
        "/web": file_metadata(
            gid = 65532,
            mode = "0755",
            uid = 65532,
        ),
    },
    include_runfiles = False,
    target_compatible_with = LINUX_AMD64,
)

# rules_img exposes manifest/config files by default. Preserve the public layout target used by
# the content witness and publisher through its documented complete OCI layout output group.
image_manifest(
    name = "image_manifest",
    created = "image_created.txt",
    entrypoint = ["/bff"],
    layers = [":image_layer"],
    target_compatible_with = LINUX_AMD64,
    user = "65532:65532",
)

filegroup(
    name = "image",
    srcs = [":image_manifest"],
    output_group = "oci_layout",
    target_compatible_with = LINUX_AMD64,
    visibility = ["//visibility:public"],
)

# Preserve the executable loader and its tarball output group for authorized runtime hosts.
image_load(
    name = "image_tarball",
    image = ":image_manifest",
    tag = "bff-template/bff:local",
    target_compatible_with = LINUX_AMD64,
)

# The image witness (spec 009 FR-007). It reads the layout the image target names.
go_test(
    name = "image_test",
    size = "small",
    srcs = ["image_test.go"],
    data = [":image"],
    env = {"IMAGE": "$(rlocationpath :image)"},
    target_compatible_with = LINUX_AMD64,
)

# The publishing path (spec 010 FR-013): the same image, pushed by digest to the repository the publishing
# script names at run time with the job's own token. Never run by the verifier.
image_push(
    name = "image_push",
    image = ":image_manifest",
    push_at_build_time = "disabled",
    registry = "ghcr.io",
    repository = "example/bff",
)

filegroup(
    name = "image_archive",
    testonly = True,
    srcs = [":image_tarball"],
    output_group = "tarball",
    visibility = ["//web/e2e:__pkg__"],
)

# The regular empty file also serves as a non-directory SSL_CERT_DIR. Both OS root paths are
# unavailable before init; this target embeds the actual production composition.
go_test(
    name = "trust_test",
    size = "small",
    srcs = ["trust_test.go"],
    data = ["empty-system-roots.pem"],
    embed = [":bff_lib"],
    env = {
        "SSL_CERT_FILE": "$(rootpath :empty-system-roots.pem)",
        "SSL_CERT_DIR": "$(rootpath :empty-system-roots.pem)",
    },
    deps = ["@org_golang_x_crypto_x509roots_fallback//bundle"],
)
