# Pinned native tools, exposed so consumers depend on this module rather than on the hub name.
[
    alias(
        name = tool,
        actual = "@multitool//tools/" + tool,
        visibility = ["//visibility:public"],
    )
    for tool in [
        "actionlint",
        "buf",
        "buildifier",
        "gitleaks",
        "prek",
        "shellcheck",
        "typos",
        "uv",
        "yq",
        "zizmor",
    ]
]
