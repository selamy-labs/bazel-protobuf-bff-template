load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files(
    [
        "install.sh",
        "guard.sh",
        "pin.sh",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "install",
    srcs = ["install.sh"],
    args = ["$(rootpath //tools:prek)"],
    data = [
        "guard.sh",
        "//tools:prek",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "pin",
    srcs = ["pin.sh"],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "pin_test",
    size = "small",
    srcs = ["pin_test.sh"],
    args = ["$(rootpath pin.sh)"],
    data = ["pin.sh"] + glob(["testdata/**"]),
)

sh_test(
    name = "defensive_test",
    size = "medium",
    srcs = ["defensive_test.sh"],
    args = [
        "$(rootpath install.sh)",
        "$(rootpath //tools:prek)",
    ],
    data = [
        "guard.sh",
        "install.sh",
        "//tools:prek",
    ],
    visibility = ["//visibility:public"],
)
