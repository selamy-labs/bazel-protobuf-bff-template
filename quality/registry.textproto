# proto-file: proto/registry.proto
# proto-message: template.quality.v1.Registry
#
# The one list of checks (spec 006 FR-001). See docs/quality/classification.md.
version: "0.1.0"

vendored_manifest: "tools/speckit/scaffold.sha256"
fixture_manifest: "quality/checks/suppression/testdata/fixtures.sha256"

# The policy inputs: what shapes a verdict, as opposed to what is judged. A change to one widens a push
# to full, and the receipt's policy_digest covers exactly these paths.
escalate: "^quality/"
escalate: "^prek\\.toml$"
escalate: "^\\.bazel"
escalate: "^MODULE\\.bazel"
escalate: "^REPO\\.bazel$"
escalate: "^BUILD\\.bazel$"
escalate: "^(go\\.(mod|sum)|package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|tsconfig\\.json)$"
escalate: "^(\\.gitignore|\\.gitleaks\\.toml|_typos\\.toml)$"
escalate: "^api/BASELINE$"
escalate: "^tools/(bootstrap|browser|checks|ci|hooks|pins|policy|proto|speckit)/"
escalate: "^tools/verify[^/]*\\.sh$"
escalate: "^web/(lint/|app/vite\\.config\\.mjs$|e2e/playwright\\.config\\.mjs$)"
escalate: "^\\.github/"

# The legs that partition `full`. CI runs one per job. spec 007 R2.
shards: "build-test"
shards: "e2e"
shards: "policy"

tools { name: "ACTIONLINT" version_args: "--version" }
tools { name: "BASELINE" }
tools { name: "BUF" version_args: "--version" }
tools { name: "BUF_CONFIG_FILE" }
tools { name: "BUILDIFIER" version_args: "--version" }
# Built from the checkout for coverage-floor. floors-from-base builds its own from the base.
tools { name: "FLOORS" }
tools { name: "GITLEAKS" version_args: "--version" }
tools { name: "GOFMT" }
tools { name: "PREK" version_args: "--version" }
tools { name: "PRETTIER" }
tools { name: "SHELLCHECK" version_args: "--version" }
tools { name: "SUPPRESSION" }
tools { name: "TYPOS" version_args: "--version" }
tools { name: "UV" version_args: "--version" }
tools { name: "VALIDATE_PROTO_FILE" }
tools { name: "YQ" version_args: "--version" }
tools { name: "ZIZMOR" version_args: "--version" }

# --- Fast content checks, at pre-commit and full.

checks {
  id: "secrets"
  shard: "policy"
  tool: "GITLEAKS"
  selector { include_vendored: true include_fixtures: true context: ".gitleaks.toml" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "secrets", "{list}", ".gitleaks.toml"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "suppression-ban"
  shard: "policy"
  tool: "SUPPRESSION"
  selector {
    include_vendored: true
    include_fixtures: true
    context: "tools/speckit/scaffold.sha256"
    context: "quality/checks/suppression/testdata/fixtures.sha256"
  }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: [
    "{SUPPRESSION}", "-root", "{root}", "-paths", "{list}",
    "-exempt", "tools/speckit/scaffold.sha256",
    "-exempt", "quality/checks/suppression/testdata/fixtures.sha256"
  ]
  witness: "//:native_fixtures_test"
}
checks {
  id: "typos"
  shard: "policy"
  tool: "TYPOS"
  selector { include_fixtures: true context: "_typos.toml" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "typos", "{list_nl}", "_typos.toml"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "format-go"
  shard: "policy"
  tool: "GOFMT"
  selector { include: "\\.go$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "format-go", "{list}"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "format-ts"
  shard: "policy"
  tool: "PRETTIER"
  selector { include: "\\.(ts|tsx|mjs)$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "format-ts", "{list}"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "format-proto"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/.*\\.proto$" context: "^api/.*\\.proto$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "format-proto", "api"]
  witness: "//api:schema_probes_test"
}
checks {
  id: "lint-proto"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/.*\\.proto$" context: "^api/.*\\.proto$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "lint-proto", "api"]
  witness: "//api:schema_probes_test"
}
checks {
  id: "format-starlark"
  shard: "policy"
  tool: "BUILDIFIER"
  selector { include: "(^|/)(BUILD|BUILD\\.bazel|MODULE\\.bazel|REPO\\.bazel)$" include: "\\.bzl$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "format-starlark", "{list}"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "shellcheck"
  shard: "policy"
  tool: "SHELLCHECK"
  selector { include: "\\.(sh|bash)$" shell_scripts: true }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "shellcheck", "{list}"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "actionlint"
  shard: "policy"
  tool: "ACTIONLINT"
  selector { include: "^\\.github/workflows/[^/]+\\.ya?ml$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "actionlint", "{list}"]
  witness: "//:native_fixtures_test"
}
checks {
  id: "zizmor"
  shard: "policy"
  tool: "ZIZMOR"
  selector { include: "^\\.github/workflows/[^/]+\\.ya?ml$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "zizmor", "{list}"]
  witness: "//:native_fixtures_test"
}

# --- Checks over the pushed commit.

checks {
  id: "tests"
  shard: "build-test"
  stages: [STAGE_PRE_PUSH, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_BAZEL
  timeout_seconds: 1500
  targets: ["//...", "@bff_template_quality//..."]
  witness: "//:verify_body_test"
}
checks {
  id: "dependency-rules"
  shard: "build-test"
  stages: [STAGE_PRE_PUSH, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_BAZEL
  timeout_seconds: 1500
  targets: ["//bff:dependency_rules_test"]
  witness: "//bff:dependency_rules_test"
}
checks {
  id: "proto-breaking"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/" }
  stages: [STAGE_PRE_PUSH, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "proto-breaking", "api", "api/BASELINE"]
  witness: "//api:schema_probes_test"
}

# --- The full policy only.

checks {
  id: "e2e-browser"
  shard: "e2e"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_BAZEL
  timeout_seconds: 1500
  targets: ["//web/e2e/..."]
  witness: "//web/e2e:defect_e2e_test"
}
checks {
  id: "coverage-floor"
  tool: "FLOORS"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 120
  after_bazel: true
  needs_coverage: true
  summary: true
  shard: "build-test"
  command: ["{FLOORS}", "check", "--root={root}", "--log={bazel_log}", "--testlogs={root}/bazel-testlogs", "--bazel-exit={bazel_exit}"]
  witness: "@bff_template_quality//checks/coverage:coverage_test"
}
checks {
  id: "floors-from-base"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 900
  exclusive: true
  needs_base: true
  shard: "policy"
  command: ["tools/policy/from_base.sh", "{base}", "{root}", "{isolation}"]
  witness: "//:from_base_test"
}
checks {
  id: "test-inventory"
  postcondition: true
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  after_bazel: true
  command: ["tools/checks/test_evidence.sh", "inventory", "{bazel_log}", "tools/checks/required_tests.txt", "{shard}"]
  witness: "//:verify_body_test"
}
checks {
  id: "sandbox-evidence"
  postcondition: true
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  after_bazel: true
  command: ["tools/checks/test_evidence.sh", "sandbox", "{bazel_log}", "{isolation}"]
  witness: "//:verify_body_test"
}
checks {
  id: "workspace-policy"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/workspace_policy.sh", "{list}"]
  witness: "//:bzlmod_policy_test"
}
checks {
  id: "implicit-config"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/config_policy.sh", "{list}"]
  witness: "//:config_policy_test"
}
checks {
  id: "bazelrc-policy"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/bazelrc_policy.sh", ".bazelrc", "tools/policy/bazelrc.allow"]
  witness: "//:config_policy_test"
}
checks {
  id: "toolchain-fixtures"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 900
  exclusive: true
  command: ["tools/policy/lock_fixture.sh"]
  witness: "toolchain-fixtures"
}
checks {
  id: "hook-e2e"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 1200
  exclusive: true
  command: ["tools/hooks/e2e.sh", "{list}", "{isolation}"]
  witness: "hook-e2e"
}
checks {
  id: "speckit-provenance"
  shard: "policy"
  tool: "UV"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 600
  exclusive: true
  needs_network: true
  command: ["tools/speckit/bootstrap.sh", "verify"]
  witness: "//:speckit_scaffold_test"
}
