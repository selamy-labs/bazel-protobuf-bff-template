# proto-file: proto/registry.proto
# proto-message: template.quality.v1.Registry
#
# This repository's policy (spec 006 FR-001, spec 008 R8). `rules` binds rules from the module's catalog,
# rules.textproto, and `checks` are this repository's own. See docs/quality/classification.md.
#
# This file and coverage_floors.json are this repository's host files. They sit under quality/ so an
# accepted base can still read them, and no consumer of the module reads either.
vendored_manifest: "tools/speckit/scaffold.sha256"
fixture_manifest: "quality/checks/suppression/testdata/fixtures.sha256"

# The policy inputs: what shapes a verdict, as opposed to what is judged. A change to one widens a push
# to full, and the receipt's policy_digest covers exactly these paths.
escalate: "^quality/"
escalate: "^prek\\.toml$"
escalate: "^\\.bazel"
escalate: "^MODULE\\.bazel"
escalate: "^REPO\\.bazel$"
escalate: "^BUILD\\.bazel$"
escalate: "^(go\\.(mod|sum)|package\\.json|pnpm-lock\\.yaml|pnpm-workspace\\.yaml|tsconfig\\.json)$"
escalate: "^(\\.gitignore|\\.gitleaks\\.toml|_typos\\.toml)$"
escalate: "^api/BASELINE$"
escalate: "^tools/(bootstrap|browser|checks|ci|hooks|pins|policy|proto|speckit)/"
escalate: "^tools/verify[^/]*\\.sh$"
escalate: "^web/(lint/|app/vite\\.config\\.mjs$|e2e/playwright\\.config\\.mjs$)"
escalate: "^\\.github/"

# The legs that partition `full`. CI runs one per job. spec 007 R2.
shards: "build-test"
shards: "e2e"
shards: "policy"

tools { name: "BASELINE" }
tools { name: "BUF" version_args: "--version" }
tools { name: "BUF_CONFIG_FILE" }
tools { name: "PREK" version_args: "--version" }
tools { name: "RELEASE" }
tools { name: "UV" version_args: "--version" }
tools { name: "VALIDATE_PROTO_FILE" }
tools { name: "YQ" version_args: "--version" }

# Rules from the catalog, each with this repository's leg and paths.
rules { id: "secrets" shard: "policy" args: [".gitleaks.toml"] context: ".gitleaks.toml" }
rules {
  id: "suppression-ban"
  shard: "policy"
  args: [
    "-exempt", "tools/speckit/scaffold.sha256",
    "-exempt", "quality/checks/suppression/testdata/fixtures.sha256"
  ]
  context: "tools/speckit/scaffold.sha256"
  context: "quality/checks/suppression/testdata/fixtures.sha256"
}
rules { id: "typos" shard: "policy" args: ["_typos.toml"] context: "_typos.toml" }
rules { id: "format-go" shard: "policy" }
rules { id: "format-ts" shard: "policy" }
rules { id: "format-starlark" shard: "policy" }
rules { id: "shellcheck" shard: "policy" }
rules { id: "actionlint" shard: "policy" }
rules { id: "zizmor" shard: "policy" }
rules { id: "tests" shard: "build-test" targets: ["//...", "@bff_template_quality//..."] }
rules { id: "coverage-floor" shard: "build-test" }
rules { id: "floors-from-base" shard: "policy" }
rules { id: "test-inventory" args: ["tools/checks/required_tests.txt"] }
rules { id: "sandbox-evidence" }

# --- This repository's own checks.

checks {
  id: "format-proto"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/.*\\.proto$" context: "^api/.*\\.proto$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "format-proto", "api"]
  witness: "//api:schema_probes_test"
}
checks {
  id: "lint-proto"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/.*\\.proto$" context: "^api/.*\\.proto$" }
  stages: [STAGE_PRE_COMMIT, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "lint-proto", "api"]
  witness: "//api:schema_probes_test"
}

checks {
  id: "dependency-rules"
  shard: "build-test"
  stages: [STAGE_PRE_PUSH, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_BAZEL
  timeout_seconds: 1500
  targets: ["//bff:dependency_rules_test"]
  witness: "//bff:dependency_rules_test"
}
checks {
  id: "proto-breaking"
  shard: "policy"
  tool: "BUF"
  selector { include: "^api/" }
  stages: [STAGE_PRE_PUSH, STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 300
  command: ["{adapter}", "proto-breaking", "api", "api/BASELINE"]
  witness: "//api:schema_probes_test"
}

checks {
  id: "e2e-browser"
  shard: "e2e"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_BAZEL
  timeout_seconds: 1500
  targets: ["//web/e2e/..."]
  witness: "//web/e2e:defect_e2e_test"
}
checks {
  id: "workspace-policy"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/workspace_policy.sh", "{list}"]
  witness: "//:bzlmod_policy_test"
}
checks {
  id: "implicit-config"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/config_policy.sh", "{list}"]
  witness: "//:config_policy_test"
}
checks {
  id: "catalog-definitions"
  shard: "policy"
  tool: "RELEASE"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 30
  command: ["{RELEASE}", "notes", "quality", "quality"]
  witness: "@bff_template_quality//release:release_test"
}
checks {
  id: "bazelrc-policy"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 60
  command: ["tools/policy/bazelrc_policy.sh", ".bazelrc", "tools/policy/bazelrc.allow"]
  witness: "//:config_policy_test"
}
checks {
  id: "toolchain-fixtures"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 900
  exclusive: true
  command: ["tools/policy/lock_fixture.sh"]
  witness: "toolchain-fixtures"
}
checks {
  id: "hook-e2e"
  shard: "policy"
  selector { include_vendored: true include_fixtures: true }
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 1200
  exclusive: true
  command: ["tools/hooks/e2e.sh", "{list}", "{isolation}"]
  witness: "hook-e2e"
}
checks {
  id: "neutrality"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 600
  allow_empty: true
  command: ["tools/release/neutrality.sh", "{root}", "--allow", "tools/release/neutrality.allow"]
  witness: "//:neutrality_test"
}

checks {
  id: "inventory"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 120
  allow_empty: true
  summary: true
  command: ["tools/release/inventory.sh", "{root}", "{YQ}"]
  witness: "//:inventory_test"
}

checks {
  id: "image-release"
  shard: "policy"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 900
  exclusive: true
  after_bazel: true
  allow_empty: true
  summary: true
  command: ["tools/checks/image_release.sh", "{bazel}", "{isolation}", "{YQ}"]
  witness: "//:image_release_test"
}

checks {
  id: "speckit-provenance"
  shard: "policy"
  tool: "UV"
  stages: [STAGE_FULL]
  classification: CLASSIFICATION_GUARANTEE
  kind: KIND_NATIVE
  timeout_seconds: 600
  exclusive: true
  needs_network: true
  command: ["tools/speckit/bootstrap.sh", "verify"]
  witness: "//:speckit_scaffold_test"
}
