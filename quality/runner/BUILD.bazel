load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runner",
    srcs = [
        "bazel.go",
        "legs.go",
        "push.go",
        "registry.go",
        "report.go",
        "select.go",
        "slots.go",
        "snapshot.go",
        "stage.go",
        "supervise.go",
        "supervise_linux.go",
        "supervise_other.go",
    ],
    importpath = "github.com/selamy-labs/bazel-protobuf-bff-template/quality/runner",
    visibility = ["//runner/cmd:__pkg__"],
    deps = [
        "//proto:registrypb",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

go_test(
    name = "runner_test",
    size = "medium",
    srcs = ["runner_test.go"],
    data = ["//:registry.textproto"],
    embed = [":runner"],
    env = {"REGISTRY": "$(rlocationpath //:registry.textproto)"},
    deps = [
        "//proto:registrypb",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)
