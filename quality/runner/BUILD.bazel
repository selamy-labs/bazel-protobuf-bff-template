load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "runner",
    srcs = [
        "base.go",
        "bazel.go",
        "legs.go",
        "push.go",
        "registry.go",
        "report.go",
        "resolve.go",
        "select.go",
        "slots.go",
        "snapshot.go",
        "stage.go",
        "supervise.go",
        "supervise_linux.go",
        "supervise_other.go",
    ],
    importpath = "github.com/selamy-labs/bazel-protobuf-bff-template/quality/runner",
    visibility = ["//runner/cmd:__pkg__"],
    deps = [
        "//proto:registrypb",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
    ],
)

# The selector's invariants as properties (spec 011 FR-009): the NUL list round-trips, selection is an ordered
# subset, idempotent and pattern-order-blind, compaction loses nothing but repeats, the policy digest sees policy only.
go_test(
    name = "select_property_test",
    size = "small",
    srcs = ["select_property_test.go"],
    embed = [":runner"],
    deps = ["//proto:registrypb"],
)

go_test(
    name = "runner_test",
    size = "medium",
    srcs = ["runner_test.go"],
    data = [
        "//:registry.textproto",
        "//:rules.textproto",
    ],
    embed = [":runner"],
    env = {
        "CATALOG": "$(rlocationpath //:rules.textproto)",
        "REGISTRY": "$(rlocationpath //:registry.textproto)",
    },
    deps = [
        "//proto:registrypb",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
    ],
)
